# ============================================================
# OVERLEAF STYLE AND CLASS FILES
# Required by Overleaf for PNAS compilation — not tracked in Git
# ============================================================
*.cls
*.sty
*.bst
*.ldf

# ============================================================
# COMPILED MANUSCRIPT PDFS
# Generated by LaTeX — source .tex files are tracked, not outputs
# ============================================================
manuscript/*.pdf
manuscript/figures/*.pdf

# ============================================================
# PRESENTATION PDFS
# Generated outputs — source files (.key, .tex, .py) are tracked
# ============================================================
presentation/**/*.pdf
presentation/*.pdf

# ============================================================
# OVERLEAF ROOT-LEVEL CLUTTER
# ============================================================
/frog.pdf
/PNAS_Logo.pdf
/pnas-sample.bib
/Research_report.pdf
/Research_report.tex

# ============================================================
# OLD BRIEF REPORT FILES (superseded by Research Article)
# ============================================================
*brief_report*
*brief_si*

# ============================================================
# LATEX COMPILATION ARTEFACTS
# ============================================================
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.blg
*.bbl
*.bcf
*.run.xml

# ============================================================
# MACOS SYSTEM FILES
# ============================================================
.DS_Store
**/.DS_Store

# ============================================================
# PYTHON ARTEFACTS
# ============================================================
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ============================================================
# WHAT IS TRACKED (for clarity)
# manuscript/              .tex, .bib, figures/*.py, mathematica/
# notes/                   apps/, github/, prereqs/, README.md
# presentation/            additive/*.py, additive/*.key, letter/
# Root                     .gitignore, LICENSE, README.md
# ============================================================